# ============================================================
# KDY SPOLU – konfigurace Supabase
# 1) Zkopíruj tento soubor jako `.env`
# 2) Otevři https://supabase.com → Dashboard → New project
# 3) Zkopíruj hodnoty z projektu → Settings → API
#    (Project URL a anon public key)
# 4) Vlož je sem a ulož. Bez nich běží aplikace jen lokálně
#    (data se ukládají jen v tomto prohlížeči).
# ============================================================

VITE_SUPABASE_URL=https://tvuj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=tvuj-anon-public-key
